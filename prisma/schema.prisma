// ─────────────────────────────────────────────────────────────────────────────
// Prenta CMS — Prisma schema
//
// AUTO-SYNCED from @prenta/core. Do NOT edit the model definitions
// by hand — they must match the bundled migrations and cms-core's API layer.
// (Generated by create-prenta/scripts/sync-prisma-assets.ts)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────

enum DocumentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
  SCHEDULED_UNPUBLISH
}

enum UserRole {
  ADMIN
  EDITOR
  AUTHOR
  CLIENT
  OWNER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ChangeType {
  CREATE
  UPDATE
  PUBLISH
  RESTORE
  DELETE
}

enum ContentIssueType {
  // Document is published but missing a `metaDescription` /
  // `seoDescription` field — the dashboard surfaces these so editors
  // can fix the SERP snippet before a competitor outranks them.
  MISSING_META_DESCRIPTION
  // Document HTML contains <img> tags without alt attributes. Hurts
  // both a11y and SEO. Counted per *document* not per image — so a
  // page with 5 alt-less images is 1 row, not 5, with `details.count`
  // capturing the per-document count.
  MISSING_ALT_TEXT
  // Internal link (same-origin URL or relative path) returned 404 /
  // 410 / DNS-failure when the link checker probed it. `details.url`
  // holds the offending URL.
  BROKEN_INTERNAL_LINK
  // Published document not touched in >90 days. Encourages refresh
  // of stale content — particularly important for "best of YEAR"
  // posts that decay rapidly.
  OUTDATED_CONTENT
}

enum WorkflowStage {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

// ─── Models ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  avatarUrl     String?
  role          UserRole  @default(AUTHOR)
  passwordHash  String?
  totpSecret    String?
  totpEnabled   Boolean   @default(false)
  // Last consumed TOTP time-step — enforces single-use so a captured code can't
  // be replayed within its validity window (#565). Null until the first TOTP login.
  lastTotpStep  Int?
  backupCodes   Json?
  authProvider  String?
  isActive      Boolean   @default(true)
  isApproved    Boolean   @default(false)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Access-control lifecycle (Users management subsystem). All additive and
  // nullable/defaulted so existing rows migrate cleanly.
  suspendedAt        DateTime?
  lockedAt           DateTime?
  forcePasswordReset Boolean   @default(false)
  mfaRequired        Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lastActiveAt       DateTime?
  invitedById        String?
  acceptedInviteAt   DateTime?

  sessions            Session[]
  oauthAccounts       OAuthAccount[]
  apiKeys             ApiKey[]
  mcpOauthGrants      McpOauthGrant[]
  documents           Document[]           @relation("CreatedDocuments")
  updatedDocuments    Document[]           @relation("UpdatedDocuments")
  versions            Version[]
  media               Media[]
  contentLocks            ContentLock[]
  notifications           InAppNotification[]
  contentTemplates        ContentTemplate[]
  passwordResetTokens     PasswordResetToken[]
  documentComments        DocumentComment[]
  documentNotifications   DocumentNotification[]

  @@map("prenta_users")
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("prenta_oauth_accounts")
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  token           String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?
  fingerprintHash String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("prenta_sessions")
}

model ApiKey {
  id             String    @id @default(cuid())
  name           String
  keyHash        String    @unique
  keyPrefix      String
  userId         String
  scopes         Json
  ipRestrictions Json?
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("prenta_api_keys")
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  ipAddress String?
  userAgent String?
  details   Json?
  timestamp DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([timestamp])
  @@map("prenta_audit_logs")
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  scope     String
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")

  documents Document[]
  media     Media[]

  @@index([scope])
  @@index([parentId])
  @@map("prenta_folders")
}

model Document {
  id                   String         @id @default(cuid())
  collection           String
  title                String?
  slug                 String?
  data                 Json
  status               DocumentStatus @default(DRAFT)
  locale               String?
  localeGroupId        String?
  createdById          String
  updatedById          String
  publishedAt          DateTime?
  scheduledAt          DateTime?
  scheduledUnpublishAt DateTime?
  deletedAt            DateTime?
  plainText            String?
  contentHash          String?
  structuredData       Json?
  templateId           String?
  workflowStage        WorkflowStage  @default(DRAFT)
  reviewerId           String?
  reviewNote           String?
  folderId             String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  createdBy     User           @relation("CreatedDocuments", fields: [createdById], references: [id])
  updatedBy     User           @relation("UpdatedDocuments", fields: [updatedById], references: [id])
  folder        Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions      Version[]
  mediaUsages   MediaUsage[]
  contentLocks  ContentLock[]
  contentIssues ContentIssue[]

  @@unique([collection, slug])
  @@index([collection, deletedAt, status])
  @@index([collection])
  @@index([status])
  @@index([deletedAt])
  @@index([publishedAt])
  @@index([folderId])
  @@index([scheduledAt])
  @@index([localeGroupId])
  @@index([createdById])
  @@map("prenta_documents")
}

model Version {
  id          String     @id @default(cuid())
  documentId  String
  data        Json
  changedById String
  changeType  ChangeType
  createdAt   DateTime   @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedById], references: [id])

  @@index([documentId])
  @@index([createdAt])
  @@map("prenta_versions")
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

model Media {
  id            String   @id @default(cuid())
  filename      String
  storageKey    String   @unique
  mimeType      String
  fileSize      Int
  width         Int?
  height        Int?
  altText       String?
  title         String?
  uploadedById  String
  focalPointX   Float?
  focalPointY   Float?
  blurHash      String?
  aiAltText     String?
  aiTags        Json?
  aiDescription String?
  folderId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Media Center additions ──────────────────────────────────────
  // All nullable / defaulted so they're safe to add to a populated DB
  // with no backfill. SEO score/issues are intentionally NOT stored —
  // they're derived on read by `calculateMediaSeoScore()` so they can
  // never drift from the metadata below.
  originalFileName   String?
  caption            String?
  description        String?
  focusKeyword       String?
  // WCAG decorative images use alt="" intentionally. Persisted so the
  // media SEO scorer awards the alt weight instead of flagging missing-alt
  // (#714). Cleared automatically when a non-empty alt is saved.
  isDecorative       Boolean  @default(false)
  tags               Json?
  // SHA-256 hex of the final stored bytes (post-optimize). Upload dedupe
  // matches this column (#718). Rows that predate it stay NULL — and dedupe
  // stays inert for them — until `prenta migrate:content-hash` fills them
  // in (#730). Nullable so the migration itself does not download every asset.
  contentHash        String?
  // `storageKey` is the object key (`prenta/media/…`). `publicUrl` is what
  // browsers fetch. Rows from before this split keep the URL in `storageKey`
  // until `backfillMediaStorageKeys` moves it. Readers use `publicUrl` first.
  publicUrl          String?
  storageProvider    String?
  durationSeconds    Float?
  thumbnailUrl       String?
  responsiveVariants Json?
  status             MediaStatus @default(READY)
  deletedAt          DateTime?

  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  mediaUsages MediaUsage[]

  @@index([folderId])
  @@index([deletedAt])
  @@index([mimeType])
  @@index([contentHash])
  @@map("prenta_media")
}

model MediaUsage {
  id         String   @id @default(cuid())
  mediaId    String
  documentId String
  fieldPath  String
  createdAt  DateTime @default(now())

  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([mediaId, documentId, fieldPath])
  @@index([documentId])
  @@map("prenta_media_usages")
}

model ContentLock {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  lockedAt   DateTime @default(now())
  expiresAt  DateTime

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([documentId])
  @@map("prenta_content_locks")
}

model InAppNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("prenta_notifications")
}

model ContentTemplate {
  id           String   @id @default(cuid())
  name         String
  collection   String
  templateData Json
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("prenta_content_templates")
}


model Redirect {
  id            String    @id @default(cuid())
  source        String
  destination   String
  statusCode    Int       @default(301)
  isRegex       Boolean   @default(false)
  notes         String?
  // Runtime + management metadata (added in 0009_seo). All defaulted so the
  // migration is safe to apply to a populated table with no backfill.
  enabled       Boolean   @default(true)
  priority      Int       @default(0)
  preserveQuery Boolean   @default(false)
  // "manual" | "import" | "ai-404-recovery" | "chain-flatten"
  source_kind   String    @default("manual")
  hits          Int       @default(0)
  lastHitAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([source])
  @@index([enabled])
  @@index([lastHitAt])
  @@map("prenta_redirects")
}

// ─── SEO module (0009_seo) ──────────────────────────────────────────

enum SeoAuditStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SeoIssueSeverity {
  critical
  warning
  info
}

enum SeoIssueStatus {
  open
  ignored
  resolved
  recurring
}

enum SeoIssueCategory {
  content
  technical
  redirects
  media
  performance
  schema
  social
  indexing
}

/// One execution of the SEO audit engine. Holds a snapshot of the site
/// score and issue counts so the Audit tab can show run history without
/// recomputing. Issues belong to a run via SEOIssue.auditRunId.
model SeoAuditRun {
  id              String         @id @default(cuid())
  status          SeoAuditStatus @default(RUNNING)
  scope           String         @default("full")
  startedById     String?
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  siteScoreBefore Int?
  siteScoreAfter  Int?
  pagesScanned    Int            @default(0)
  issuesFound     Int            @default(0)
  criticalCount   Int            @default(0)
  warningCount    Int            @default(0)
  infoCount       Int            @default(0)
  errorMessage    String?
  metadata        Json?

  issues SeoIssue[]

  @@index([status])
  @@index([startedAt])
  @@map("prenta_seo_audit_runs")
}

/// A single SEO problem detected by an audit run. `issueKey` is a stable
/// hash of (type + entityId/url) used to carry status across runs so a
/// resolved/ignored issue stays resolved/ignored when re-detected.
model SeoIssue {
  id               String           @id @default(cuid())
  auditRunId       String?
  issueKey         String
  entityType       String?
  entityId         String?
  entityTitle      String?
  url              String?
  severity         SeoIssueSeverity
  category         SeoIssueCategory
  type             String
  title            String
  description      String?
  impact           String?
  recommendation   String?
  status           SeoIssueStatus   @default(open)
  fixable          Boolean          @default(false)
  fixActionType    String?
  relatedEntityIds Json?
  source           String           @default("audit")
  firstDetectedAt  DateTime         @default(now())
  lastDetectedAt   DateTime         @default(now())
  resolvedAt       DateTime?
  resolvedById     String?
  metadata         Json?

  auditRun SeoAuditRun? @relation(fields: [auditRunId], references: [id], onDelete: SetNull)

  @@index([auditRunId])
  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([issueKey])
  @@index([entityId])
  @@map("prenta_seo_issues")
}

/// A 404 hit observed by the redirect middleware. Aggregated per path so
/// the Redirects tab can surface "broken URLs still getting traffic".
model Redirect404Hit {
  id          String    @id @default(cuid())
  path        String
  hits        Int       @default(1)
  referrer    String?
  resolvedAt  DateTime?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@unique([path])
  @@index([lastSeenAt])
  @@map("prenta_redirect_404_hits")
}

/// Aggregated AI-crawler activity for the admin "AI crawler activity" panel.
/// One row per (bot token, surface), upserted on each hit so the table stays
/// bounded (~known bots × surfaces) and needs no periodic pruning.
/// `surface` ∈ "llms" | "llms-full" | "md" | "honeypot".
/// `category` mirrors the ai-bots taxonomy: "training" | "retrieval" | "other".
model AiCrawlerHit {
  id          String   @id @default(cuid())
  bot         String
  surface     String
  category    String   @default("other")
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([bot, surface])
  @@index([lastSeenAt])
  @@map("prenta_ai_crawler_hits")
}

/// One row per (page path, day) of Google Search Console search analytics,
/// written by the nightly search sync. Dates are stored exactly as GSC
/// reports them (property timezone) — never converted to UTC. Rolling
/// 90-day window, pruned during sync.
model SearchPerfDaily {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  path        String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([date, path])
  @@index([path])
  @@map("prenta_search_perf_daily")
}

/// Per-page search insight snapshot: trailing-28-day totals + prior-window
/// deltas (computed from SearchPerfDaily), top queries from GSC, and CrUX
/// Core Web Vitals p75s. One row per normalized path, upserted by the sync.
/// `cwvStatus` null means CrUX has no field data for the URL (normal for
/// low-traffic pages), never an error.
model SearchPageInsight {
  id                 String    @id @default(cuid())
  path               String    @unique
  entityId           String?
  entityType         String?
  topQueries         Json?
  clicks28d          Int       @default(0)
  impressions28d     Int       @default(0)
  avgPosition28d     Float?
  clicksPrev28d      Int       @default(0)
  impressionsPrev28d Int       @default(0)
  avgPositionPrev28d Float?
  lcpMs              Int?
  inpMs              Int?
  cls                Float?
  cwvStatus          String?
  cwvCollectedAt     DateTime?
  createdAt          DateTime  @default(now())
  lastSyncedAt       DateTime  @updatedAt

  @@index([impressions28d])
  @@index([entityId])
  @@map("prenta_search_page_insights")
}

/// GEO measurement: one row per (UTC day, crawler token, path) for known AI
/// training / AI retrieval / search crawlers observed by the site middleware
/// (spec 2026-09-08-geo-measurement-design.md §4). Distinct paths per
/// (date, bot) are capped at GEO_CRAWL_PATH_CAP; overflow rolls into a
/// single "(other)" row. Pruned by the cleanup cron after geoRetentionDays.
model GeoCrawlDaily {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  bot       String
  category  String
  path      String
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, bot, path])
  @@index([date])
  @@index([bot, date])
  @@map("prenta_geo_crawl_daily")
}

/// GEO measurement: one row per (UTC day, AI engine name, path) for visits
/// referred by an answer engine (Referer host or utm_source). Distinct paths
/// per (day, engine) are capped like GeoCrawlDaily — overflow rolls into a
/// single path = "(other)" row — since the public beacon cannot prove a path
/// exists on the site. Pruned with GeoCrawlDaily.
model GeoReferralDaily {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  engine    String
  path      String
  visits    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, engine, path])
  @@index([date])
  @@index([engine, date])
  @@map("prenta_geo_referral_daily")
}

/// An AI/heuristic suggestion for a 404 destination. Confidence-scored and
/// never auto-applied below the configured threshold.
model RedirectSuggestion {
  id         String   @id @default(cuid())
  fromPath   String
  toPath     String
  confidence Int      @default(0)
  reason     String?
  // "open" | "accepted" | "dismissed"
  status     String   @default("open")
  source     String   @default("ai-404-recovery")
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([fromPath])
  @@map("prenta_redirect_suggestions")
}

/// One row per change SEO Autopilot wrote (spec 2026-09-07-auto-apply-policy-engine §4).
/// `before`/`after` hold the field-level diff for issue fixes, or the created
/// redirect (after) for redirects. `before` is null for redirects: autopilot
/// never overwrites an existing redirect. Rows are never deleted; revert flips `status`.
model SeoAutoApply {
  id               String    @id @default(cuid())
  // 'issue-fix' | 'redirect'
  kind             String
  issueId          String?
  // AutopilotIssueType
  issueType        String
  entityId         String?
  collection       String?
  // Public path at apply time — outcome-watch key into prenta_search_perf_daily.
  path             String?
  redirectId       String?
  before           Json?
  after            Json
  // { source, brandAlignment, confidence, checks }
  gate             Json
  // 'applied' | 'verify_failed' | 'reverted' | 'outcome_reverted'
  status           String
  // 'pending' | 'held' | 'regressed' | 'insufficient_data' | 'skipped'
  outcome          String    @default("pending")
  outcomeMetrics   Json?
  outcomeCheckedAt DateTime?
  versionId        String?
  appliedById      String
  appliedAt        DateTime  @default(now())
  revertedAt       DateTime?
  revertedById     String?
  // 'verify_failed' | 'outcome_regression' | 'manual'
  revertReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, appliedAt])
  @@index([entityId])
  @@index([outcome, appliedAt])
  @@index([issueId])
  @@map("prenta_seo_auto_applies")
}

// A versioned snapshot of a form's field schema. Saving a form's schema in
// the admin creates a new row here; submissions reference the version they
// were captured against so historical entries always render with the fields
// that existed at submit time, even after the live form schema changes.
model FormSchemaVersion {
  id          String   @id @default(cuid())
  formId      String
  version     Int
  fields      Json
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([formId, version])
  @@index([formId])
  @@map("prenta_form_schema_versions")
}

model FormSubmission {
  id              String    @id @default(cuid())
  // Per-instance sequential number shown in the UI (e.g. #00001). Assigned by
  // the submission service inside a transaction; nullable for legacy rows.
  entryNumber     Int?
  formId          String
  schemaVersionId String?
  data            Json
  // Server-derived, type-coerced view of `data` (e.g. checkbox -> bool,
  // number -> number) used for export/search. `data` keeps the raw payload.
  normalizedData  Json?
  attribution     Json?
  senderName      String?
  senderEmail     String?
  senderPhone     String?
  preview         String?
  // Legacy free-form status ('new'); superseded by the booleans below but
  // retained so existing rows/integrations keep working.
  status          String    @default("new")
  unread          Boolean   @default(true)
  starred         Boolean   @default(false)
  archived        Boolean   @default(false)
  spamStatus      String    @default("clean")
  ipAddressHash   String?
  userAgent       String?
  referrer        String?
  pageUrl         String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  submittedAt     DateTime  @default(now())
  readAt          DateTime?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  files      FormSubmissionFile[]
  deliveries FormDeliveryAttempt[]

  @@index([formId])
  @@index([submittedAt])
  @@index([senderEmail])
  @@index([formId, submittedAt])
  @@map("prenta_form_submissions")
}

// File attachments for a submission. Files are stored via the configured
// storage adapter (never inline in the DB); this row tracks metadata and the
// storage key needed to mint a secure download link.
model FormSubmissionFile {
  id                String   @id @default(cuid())
  submissionId      String
  fieldKey          String
  mediaAssetId      String?
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  publicUrl         String?
  secureDownloadUrl String?
  createdAt         DateTime @default(now())

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("prenta_form_submission_files")
}

// Per-form outbound webhook configuration. Distinct from the global
// WebhookEndpoint registry so form owners can wire delivery without admin
// access to site-wide webhooks.
model FormWebhook {
  id                       String    @id @default(cuid())
  formId                   String
  url                      String
  secret                   String
  /// Previous signing secret (encrypted) kept during rotation grace (#679).
  previousSecret           String?
  previousSecretValidUntil DateTime?
  enabled                  Boolean   @default(true)
  events                   Json
  retryCount               Int       @default(0)
  lastDeliveryAt           DateTime?
  lastDeliveryStatus       String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([formId])
  @@map("prenta_form_webhooks")
}

/// Per-submission notify/webhook/email delivery attempts (#675).
/// Fail-open: the lead is always persisted; this table tracks best-effort fan-out.
model FormDeliveryAttempt {
  id             String    @id @default(cuid())
  submissionId   String
  formId         String
  /// email_notify | email_autoresponder | form_webhook
  channel        String
  /// Recipient email or webhook URL (never secrets).
  destination    String
  webhookId      String?
  /// pending | retrying | success | failed | skipped
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  error          String?
  responseStatus Int?
  skippedReason  String?
  /// Webhook payload (or email meta) for retry without re-submitting.
  payload        Json?
  /// When an operator alert email was sent for a permanent failure.
  alertedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  submission FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([formId, status])
  @@index([submissionId])
  @@index([status, nextRetryAt])
  @@map("prenta_form_delivery_attempts")
}

model WebhookEndpoint {
  id                       String    @id @default(cuid())
  url                      String
  events                   Json
  secret                   String
  /// Previous signing secret (encrypted) kept during rotation grace (#679).
  previousSecret           String?
  previousSecretValidUntil DateTime?
  active                   Boolean   @default(true)
  name                     String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  deliveries WebhookDeliveryLog[]

  @@map("prenta_webhook_endpoints")
}

model WebhookDeliveryLog {
  id             String    @id @default(cuid())
  endpointId     String
  event          String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([status])
  @@index([nextRetryAt])
  @@map("prenta_webhook_deliveries")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("prenta_password_reset_tokens")
}

model Invite {
  id              String       @id @default(cuid())
  email           String
  role            UserRole
  status          InviteStatus @default(PENDING)
  tokenHash       String
  message         String?
  // Stored as a bare id (not an FK relation) to mirror AuditLog: an inviter
  // being removed must never cascade-delete the invite history.
  invitedByUserId String?
  acceptedUserId  String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([email])
  @@index([tokenHash])
  @@index([status])
  @@map("prenta_invites")
}

model ScriptTag {
  id               String   @id @default(cuid())
  name             String
  code             String   @db.Text
  placement        String
  scope            String
  targetPaths      String[]
  priority         Int      @default(100)
  enabled          Boolean  @default(true)
  /// Inject `async` into external <script src> tags so they don't block render.
  loadAsync        Boolean  @default(false)
  /// Skip this tag when the page is rendered inside CMS preview mode.
  disableInPreview Boolean  @default(true)
  /// Cookie-consent category gate: none | analytics | marketing | functional | preferences.
  consentCategory  String   @default("none")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled])
  @@index([placement])
  @@map("prenta_script_tags")
}

// ─── Dashboard metrics ─────────────────────────────────────────────────────

/// Per-minute pre-aggregated request counters that power the
/// "Delivery API" dashboard tiles (request volume, error rate,
/// average latency, p95). One row per (bucketStart × route × statusBucket).
///
/// Why pre-aggregated minute buckets and not per-request rows:
///   - 24h of traffic at 10 req/s on 20 routes ≈ 17M raw rows; the
///     equivalent minute-bucketed table is ≤ 28,800 rows (1440 × 20).
///   - Vercel Functions are concurrency-bounded; an O(1) UPSERT per
///     request is cheaper than O(write+query) per dashboard load.
///   - 7-day retention is enforced by the
///     `/api/cms/cron/api-metrics-prune` cron, so the table stays
///     bounded.
///
/// `latencyHistogram` is a fixed 12-bucket log-scale array (ms):
///   [<1, 1-2, 2-4, 4-8, 8-16, 16-32, 32-64, 64-128, 128-256,
///    256-512, 512-1024, >1024]
/// Cumulative-sum to estimate p95 with ~10% accuracy without
/// per-request samples. The `delivery-stats` reader merges
/// histograms across buckets before estimating.
model ApiRequestMetric {
  id               String   @id @default(cuid())
  /// UTC minute boundary (`floor(time, '1 minute')`). The unique
  /// constraint on `(bucketStart, route, statusBucket)` lets the
  /// request logger UPSERT in one round-trip per request.
  bucketStart      DateTime
  /// Normalised request route (e.g. `/collections/posts` — never
  /// the per-document `/collections/posts/abc123`). Normalisation
  /// happens in `instrumentation.ts` so the cardinality stays
  /// bounded.
  route            String
  /// HTTP status family — one of `2xx`, `3xx`, `4xx`, `5xx`,
  /// `other`. Storing the bucket rather than the raw status lets
  /// us answer "error rate?" with a single GROUP BY.
  statusBucket     String
  count            Int      @default(0)
  /// Sum of `responseMs` across `count` requests. Average latency
  /// = `sum(sumLatencyMs) / sum(count)` over the window.
  sumLatencyMs     Float    @default(0)
  /// Max single-request latency in this bucket. Useful as a
  /// fast-path tail-latency indicator and as a sanity check on
  /// the histogram estimator.
  maxLatencyMs     Float    @default(0)
  /// 12-bucket log-scale histogram (see model doc). Stored as
  /// `Json` so the schema doesn't have to change when we revise
  /// bucket boundaries.
  latencyHistogram Json
  updatedAt        DateTime @updatedAt

  @@unique([bucketStart, route, statusBucket])
  @@index([bucketStart])
  @@map("prenta_api_request_metrics")
}

/// Persisted content-quality issues surfaced by the nightly
/// content-health scan. The Dashboard's "Content Health" card
/// aggregates these rows by `type` to produce the issue list.
///
/// Upsert key is `(documentId, type)` so the scanner is
/// idempotent — re-running yields the same row count, and a row
/// "self-resolves" by being absent from the next scan (the
/// scanner uses a `firstScanAt`-watermark + delete pattern).
model ContentIssue {
  id          String           @id @default(cuid())
  documentId  String
  type        ContentIssueType
  /// Per-issue count (e.g. 5 alt-less images = `count: 5` even
  /// though it's 1 row). Lets the dashboard show real numbers
  /// without re-scanning the document HTML on each page load.
  count       Int              @default(1)
  /// Type-specific payload — the broken URL, the page's
  /// `updatedAt`, the offending image src, etc. JSON so each
  /// issue type can carry its own shape without schema churn.
  details     Json?
  firstSeenAt DateTime         @default(now())
  lastSeenAt  DateTime         @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, type])
  @@index([type])
  @@index([documentId])
  @@map("prenta_content_issues")
}

/// Persisted Yjs state for a document (`@prenta/realtime`). Optional: empty
/// when collaboration is unused. Cms-core queries this from `/realtime/sync`.
model DocumentCRDT {
  documentId      String   @id
  state           Bytes
  stateVector     Bytes
  version         Int      @default(0)
  lastUpdatedAt   DateTime @default(now()) @updatedAt
  lastUpdatedById String?
  createdAt       DateTime @default(now())

  @@index([lastUpdatedAt])
  @@map("prenta_document_crdts")
}

/// Threaded inline comment. Soft-deletes keep replies attached. Optional.
model DocumentComment {
  id           String    @id @default(cuid())
  documentId   String
  parentId     String?
  parent       DocumentComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      DocumentComment[] @relation("CommentThread")
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  body         String    @db.Text
  anchor       Json?
  resolvedAt   DateTime?
  resolvedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([documentId])
  @@index([documentId, resolvedAt])
  @@index([parentId])
  @@index([userId])
  @@index([createdAt])
  @@map("prenta_document_comments")
}

/// Per-user notification feed for collaboration events.
model DocumentNotification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  documentId String?
  commentId  String?
  payload    Json
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([documentId])
  @@index([commentId])
  @@map("prenta_document_notifications")
}

/// Background work for SEO audit, content health, and batch AI.
/// `status` is queued | running | succeeded | dead | cancelled. Only queued
/// rows are claimed: a dead row is the dead-letter and a cancelled row is
/// final, so neither runs again. Ids are minted by the queue so a stub
/// database that ignores `create` still returns a job id.
model Job {
  id                String    @id
  type              String
  payload           Json
  status            String
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  runAt             DateTime
  lockedAt          DateTime?
  lastError         String?
  progress          Json
  cancelRequestedAt DateTime?
  cancelledById     String?
  /// Who queued it. Null for cron jobs and rows queued before 0026.
  createdById       String?
  title             String?
  scope             String?
  tokensIn          Int       @default(0)
  tokensOut         Int       @default(0)
  explain           String?
  summary           String?
  results           Json?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  events            JobEvent[]
  reviewItems       JobReviewItem[]

  @@index([status, runAt])
  @@index([createdAt])
  @@map("prenta_jobs")
}

/// Worker log for a job. The admin shows the newest 50; a job that ends keeps its newest 100.
model JobEvent {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  kind       String
  message    String
  detail     String?
  durationMs Int?
  tokens     Int?

  @@index([jobId, at])
  @@map("prenta_job_events")
}

/// One proposed document change from a review-first batch AI job.
model JobReviewItem {
  id                String    @id @default(cuid())
  jobId             String
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  documentId        String
  documentTitle     String
  url               String    @default("")
  field             String
  before            String
  after             String
  editedAfter       String?
  status            String    @default("pending")
  decidedById       String?
  decidedAt         DateTime?
  appliedRevisionId String?

  @@index([jobId, status])
  @@map("prenta_job_review_items")
}

/// Machine-written state keyed by name, such as the job worker's last tick
/// (`jobs.worker`). Separate from the `settings` global so a background write
/// can never overwrite an admin's save, and no user id is needed.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("prenta_system_settings")
}

/// Site chrome for Appearance > Header & Footer, one row per region.
/// `header` and `footer` hold the code-first schema the site sends on deploy
/// (`schema`, with `source.commit`; variants and fields are ordered pairs
/// because JSONB doesn't keep key order), the site-default `variant`, the saved
/// field `values`, and the values a schema change dropped (`orphans`, each with
/// `orphanedAt`, kept 30 days). `announcement` holds the announcement bar in
/// `values`, and in `state` the schedule boundaries that already revalidated
/// the site. Every write is conditional on `version`, so a save and a schema
/// read can't overwrite each other. `updatedAt` is set by the code, not
/// `@updatedAt`'s default: it moves only when the saved values change.
model ChromeRegion {
  region      String   @id
  schema      Json?
  schemaHash  String?
  variant     String?
  values      Json     @default("{}")
  orphans     Json     @default("[]")
  state       Json?
  version     Int      @default(0)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prenta_chrome_regions")
}

/// One MCP OAuth grant. The authorization code and the current refresh token
/// are stored only as SHA-256 hashes. `familyId` groups rotations; replaying a
/// replaced refresh token revokes every row in the family.
model McpOauthGrant {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId            String
  redirectUri         String
  resource            String
  scope               String
  codeChallenge       String
  codeHash            String?   @unique
  codeExpiresAt       DateTime?
  codeConsumedAt      DateTime?
  refreshHash         String?   @unique
  refreshExpiresAt    DateTime?
  familyId            String
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([clientId])
  @@map("prenta_mcp_oauth_grants")
}

/// Hashes of refresh tokens that have already been rotated. Presenting one
/// revokes the family.
model McpOauthRefreshReplay {
  hash      String   @id
  familyId  String
  createdAt DateTime @default(now())

  @@index([familyId])
  @@map("prenta_mcp_oauth_refresh_replays")
}

/// Pending authorize request, before the person allows or denies it.
/// Short-lived. The id is the browser transaction, not a credential.
model McpOauthTransaction {
  id             String   @id
  clientId       String
  clientName     String
  redirectUri    String
  resource       String
  scope          String
  codeChallenge  String
  state          String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([expiresAt])
  @@map("prenta_mcp_oauth_transactions")
}
