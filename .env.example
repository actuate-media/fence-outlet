# ── Database (Required) ──────────────────────────────────
# Pooled connection (runtime queries — provisioned by the Vercel Marketplace)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"
# Direct TCP connection (migrations - non-pooled)
DIRECT_DATABASE_URL="postgresql://user:password@db.prisma.io:5432/postgres?sslmode=require"
# Preview uses a second database. On the Vercel Preview environment, set
# DATABASE_URL and DIRECT_DATABASE_URL to that database, and set
# PRENTA_PRODUCTION_DATABASE_URL / PRENTA_PRODUCTION_DIRECT_DATABASE_URL
# to the production values. Preview builds migrate only when the
# preview URLs differ from those production values.

# ── Security (Required) ──────────────────────────────────
# Min 32 chars — used for JWT signing and session encryption
CMS_SECRET=""
# 32-byte hex key for AES-256-GCM field encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CMS_ENCRYPTION_KEY=""
# 32-byte hex key that encrypts nightly database dumps (prenta db:backup).
# Distinct from CMS_ENCRYPTION_KEY. Escrow it: losing it loses the backups.
BACKUP_ENCRYPTION_KEY=""
# Protects /api/cms/cron/* (Vercel sends Authorization: Bearer <CRON_SECRET>)
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# ── Public ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Canonical origin for sitemap, OG tags, and JSON-LD. Must match your
# production domain (no trailing slash). Also mirrored in prenta.config.ts
# `seo.siteUrl` — Admin → Settings → General can override without redeploying.

# ── First-Run Admin (Optional) ───────────────────────────
# If set, auto-creates the initial admin user on first boot.
# If not set, visit /admin to create via the setup wizard.
# CMS_ADMIN_EMAIL=""
# CMS_ADMIN_PASSWORD=""

# ── Rate Limiting (Optional, recommended for production) ──
# Adding Upstash from the Vercel Marketplace auto-provisions
# KV_REST_API_URL / KV_REST_API_TOKEN — the rate limiter accepts
# those automatically, so you usually do not set anything here.
# Set these only when pointing at an Upstash store directly:
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Forms & CRM (plugin-forms) ───────────────────────────
# After `npm run populate`, open Admin → Forms → [form] → Integrations
# and paste your Zapier Catch Hook URL (Webhooks by Zapier → Catch Hook).
# Email notifications use RESEND_API_KEY / SMTP when the email plugin is enabled.

# ── Email (Optional) ─────────────────────────────────────
# Choose a provider with EMAIL_PROVIDER: resend | ses | smtpcom | smtp.
# When omitted it is inferred: SMTP_HOST → smtp, else RESEND_API_KEY → resend.
# EMAIL_PROVIDER=""
EMAIL_FROM="noreply@example.com"
#
# Resend (HTTP API):
RESEND_API_KEY=""
#
# Generic SMTP (any mail server; run `npm i nodemailer`):
# EMAIL_PROVIDER="smtp"
# SMTP_HOST=""
# SMTP_PORT="587"           # 587 = STARTTLS, 465 = implicit TLS
# SMTP_SECURE="false"       # "true" forces implicit TLS
# SMTP_USER=""
# SMTP_PASS=""

# ── Media Storage ────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Error reporting (Optional) ───────────────────────────
# Server API 500s. @sentry/node is included; reporting no-ops when unset.
# SENTRY_DSN=""
# Release tag on server events, e.g. prenta@1.2.3
# SENTRY_RELEASE=""
# Admin ErrorBoundary. These two are inlined into the admin bundle at build time.
# NEXT_PUBLIC_SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_RELEASE=""

# ── CAPTCHA (Optional) ───────────────────────────────────
# Google reCAPTCHA v3 — get keys at https://www.google.com/recaptcha/admin
# RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""
# RECAPTCHA_SCORE_THRESHOLD="0.5"
#
# OR Cloudflare Turnstile — get keys at https://dash.cloudflare.com/turnstile
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
