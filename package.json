{
  "name": "fence-outlet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && node scripts/deploy-migrate.mjs && next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "generate": "prenta generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prenta seed",
    "populate": "prenta populate",
    "doctor": "prenta doctor",
    "deploy:check": "prenta deploy:check",
    "verify": "prenta verify --full",
    "blocks:extract": "prenta-component-blocks extract --root ./src/blocks --out ./prenta-blocks.json",
    "blocks:diff": "prenta-component-blocks extract --root ./src/blocks --out ./.prenta-blocks.next.json && prenta-component-blocks diff ./prenta-blocks.json ./.prenta-blocks.next.json",
    "verify:sections": "node scripts/verify-sections.mjs"
  },
  "dependencies": {
    "@prenta/admin": "^2.14.8",
    "@prenta/component-blocks": "^0.3.1",
    "@prenta/core": "^8.18.4",
    "@prenta/mcp-server": "^2.3.7",
    "@prenta/platform-vercel": "^1.0.1",
    "@prenta/plugin-email": "^1.0.1",
    "@prenta/plugin-forms": "^1.0.2",
    "@prenta/plugin-media": "^1.0.1",
    "@prenta/plugin-redirects": "^1.0.1",
    "@prenta/plugin-seo": "^2.0.1",
    "@prenta/sections-react": "^0.20.11",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.63.0",
    "@vercel/blob": "^2.4.0",
    "@vercel/functions": "^3.6.0",
    "dotenv": "17.4.2",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.19.0",
    "next": "^16.4.2",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@prenta/cli": "^1.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.0"
  }
}
